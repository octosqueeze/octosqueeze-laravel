{
    "name": "octosqueeze/octosqueeze-laravel",
    "description": "OctoSqueeze Laravel package for automatic image compression",
    "keywords": ["octosqueeze", "laravel", "image", "compression", "webp", "avif", "optimization"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://octosqueeze.com/",
    "authors": [
        {
            "name": "OctoSqueeze Team",
            "email": "contact@octosqueeze.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "octosqueeze/php-client": "^1.0|dev-main"
    },
    "autoload": {
        "psr-4": {
            "OctoSqueeze\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OctoSqueeze\\Laravel\\OctoSqueezeServiceProvider"
            ],
            "aliases": {
                "OctoSqueeze": "OctoSqueeze\\Laravel\\Facades\\OctoSqueeze"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
